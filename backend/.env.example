# Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE
YAML_AGENT_MODEL=gemini-2.5-flash

# true = answer from canned responses in mock_runner.py, no API key needed.
# Useful for frontend work and for running the server locally.
MOCK_MODE=false
